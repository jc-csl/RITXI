# DIAGNOSTICAR_5_ACTIVIDADES_RECUPERADAS.ps1
# Comprueba herramientas recuperadas: Ollama, imagen y bailes.

$ErrorActionPreference = "Continue"
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$OutputEncoding = [System.Text.Encoding]::UTF8

$Root = Split-Path -Parent $MyInvocation.MyCommand.Path
$Base = Join-Path $Root "src\ahootsa_realtime_ollama_desktop_app"
$Profile = Join-Path $Base "profiles\ahootsa_realtime_es"
$Needed = @(
  "ask_ollama",
  "camera",
  "camera_pc",
  "explore_image",
  "explorar_imagen",
  "list_panel_dances_activities",
  "play_panel_dance_activity",
  "list_community_dances",
  "play_community_dance",
  "list_emotions",
  "list_all_activities"
)

Write-Host "============================================================"
Write-Host "Diagnóstico actividades recuperadas Ahootsa 5.0.25"
Write-Host "============================================================"

foreach ($loc in @($Base, $Profile)) {
  Write-Host ""
  Write-Host "Tools en $loc"
  $tools = Get-Content -LiteralPath (Join-Path $loc "tools.txt") -ErrorAction SilentlyContinue
  foreach ($n in $Needed) {
    if ($tools -contains $n) { Write-Host "[OK] $n" }
    else { Write-Host "[ERROR] Falta $n" }
  }
}

Write-Host ""
Write-Host "Archivos .py:"
foreach ($n in @("ask_ollama","camera_pc","explore_image","explorar_imagen","list_panel_dances_activities","play_panel_dance_activity","list_community_dances","play_community_dance","list_all_activities")) {
  $p = Join-Path $Base ($n + ".py")
  if (Test-Path $p) { Write-Host "[OK] $n.py" }
  else { Write-Host "[ERROR] Falta $n.py" }
}

Write-Host ""
Write-Host "Ollama:"
try {
  $tags = Invoke-RestMethod "http://127.0.0.1:11434/api/tags" -TimeoutSec 5
  Write-Host "[OK] Ollama responde."
  $tags.models | Select-Object name | Format-Table -AutoSize
} catch {
  Write-Host "[WARN] Ollama no responde en 127.0.0.1:11434"
  Write-Host $_.Exception.Message
}

Write-Host ""
Write-Host "Nota: para explorar imágenes con descripción automática se necesita un modelo vision en Ollama, por ejemplo llava:latest, configurado con OLLAMA_VISION_MODEL."
